# Supabase (Project Settings > API). Copier ce fichier en .env.local et y mettre les vraies valeurs.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Connexion Google dans l'application (Google Identity Services). ID client OAuth « Application Web » :
# public, ce n'est pas un secret. Le secret client reste uniquement dans Supabase.
VITE_GOOGLE_CLIENT_ID=
